{
  "name": "sankeyapplication-monorepo",
  "private": true,
  "version": "1.1.9",
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "lint": "pnpm -r --no-bail run lint",
    "lint:ci": "pnpm -r --no-bail run lint:ci",
    "typecheck": "pnpm --filter @terriflux/sankeyapplication exec tsc -p . --noEmit",
    "test": "pnpm --filter open-sankey run test",
    "build": "pnpm --filter @terriflux/sankeyapplication run build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "core-js",
      "core-js-pure"
    ],
    "overrides": {
      "react-draggable": "4.4.6"
    }
  }
}
