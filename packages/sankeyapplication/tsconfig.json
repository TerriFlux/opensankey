{
  "compilerOptions": {
    "target": "ES6",
    "module": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "sourceMap": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "downlevelIteration": true,
    "jsx": "react",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
  },
  "include": [
    "src",
    "../login-component/client/src/UserPages/UserPages.tsx",
    "../login-component/client/src/IconLibraryLoginComponent.tsx",
    "../opensankey/opensankey/client/src/**/*.d.ts",
    "../opensankey-plus/client/src/**/*.d.ts",
    "../login-component/client/src/**/*.d.ts"
  ]
}
