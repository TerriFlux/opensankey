{
  "compilerOptions": {
    "target": "ES6",
    "module": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "sourceMap": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "downlevelIteration": true,
    "jsx": "react",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
  },
  "include": ["src", "../submodules/LoginComponent/client/src/UserPages/UserPages.tsx", "../submodules/LoginComponent/client/src/IconLibraryLoginComponent.tsx"]
}
