{
  "name": "@terriflux/sankeyapplication",
  "version": "1.2.0",
  "packageManager": "pnpm@10.4.1",
  "type": "module",
  "homepage": ".",
  "proxy": "http://127.0.0.1:5000/",
  "main": "dist/lib.js",
  "module": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "//": "Comment on craco : It overrides  react-script webpack config file ",
    "start": "craco start",
    "build": "craco build",
    "lint": "eslint --fix ./src",
    "lint:ci": "eslint ./src",
    "dist": "tsc -p .",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "build_zip": "shx rm -rf $npm_config_artifacts_path/$npm_config_pack_name.$npm_config_publish_name.zip && cross-conf-env npm-build-zip --name=$npm_config_publish_name --destination  $npm_config_artifacts_path"
  },
  "dependencies": {
    "@chakra-ui/anatomy": "^2.3.4",
    "@chakra-ui/react": "^2.10.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@stripe/react-stripe-js": "^2.9.0",
    "@stripe/stripe-js": "^4.10.0",
    "d3-selection": "^3.0.0",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.0.3",
    "react": "^18.3.1",
    "react-color": "^2.19.3",
    "react-d3-tree": "^3.6.5",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^15.4.0",
    "react-icons": "^5.4.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.29.0",
    "react-text-loop": "^2.3.0",
    "@terriflux/opensankey": "workspace:*",
    "@terriflux/opensankey-plus": "workspace:*",
    "@terriflux/login-component": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.26.8",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/preset-env": "^7.26.8",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.26.0",
    "@craco/craco": "^7.1.0",
    "@eslint/js": "^9.20.0",
    "@jest/globals": "^29.7.0",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/colormap": "^2.3.4",
    "@types/d3-array": "^3.2.1",
    "@types/d3-color": "^3.1.3",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-ease": "^3.0.2",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-scale-chromatic": "^3.0.3",
    "@types/d3-selection": "^3.0.10",
    "@types/d3-transition": "^3.0.8",
    "@types/d3-zoom": "^3.0.8",
    "@types/deep-diff": "^1.0.5",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^29.5.14",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.13.4",
    "@types/pako": "^2.0.3",
    "@types/prop-types": "^15.7.14",
    "@types/react": "^18.3.18",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "^18.3.5",
    "@types/react-google-recaptcha": "^2.1.9",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-test-renderer": "^18.3.1",
    "@types/webpack-env": "^1.18.8",
    "babel-loader": "^9.2.1",
    "cross-conf-env": "^1.3.0",
    "csstype": "^3.1.3",
    "eslint": "^8.57.1",
    "eslint-plugin-mocha": "^10.5.0",
    "eslint-plugin-react": "^7.37.4",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "npm-build-zip": "^1.0.4",
    "postcss": "^8.5.2",
    "react-scripts": "^5.0.1",
    "shx": "^0.3.4",
    "ts-loader": "^9.5.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^7.18.0",
    "web-vitals": "^4.2.4"
  },
  "overrides": {
    "postcss": "$postcss",
    "@svgr/webpack": "$@svgr/webpack"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
