# Aucun registre n'est declare ici : @terriflux/opensankey est publie sur npmjs
# public, donc le registre par defaut suffit. C'est la condition pour que
# l'exemple s'installe sans jeton — sur CodeSandbox, chez un integrateur, ou
# dans n'importe quel CI tiers.

# react-scripts 5 declare des peers anciens (typescript ^3 || ^4) alors que cet
# exemple compile en TypeScript 5 : sans ce reglage, npm >= 7 refuse de resoudre
# l'arbre et `npm install` echoue avant meme la compilation.
legacy-peer-deps=true
