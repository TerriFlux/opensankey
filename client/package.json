    "framer-motion": "^11.1.7",
    "globals": "^15.0.0",
    "html-react-parser": "^5.1.10",
    "i18next": "^23.11.2",
    "i18next-browser-languagedetector": "^7.2.1",
    "jest": "^29.7.0",
    "lz-string": "^1.5.0",
    "npm-build-zip": "^1.0.4",
    "postcss": "^8.4.38",
    "react": "^18.3.0",
    "react-beforeunload": "^2.6.0",
