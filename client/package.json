{
  "name": "sankeysuite",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "homepage": ".",
  "proxy": "http://127.0.0.1:5000/",
  "scripts": {
    "//": "Comment on craco : It overrides  react-script webpack config file ",
    "start": "craco start",
    "build": "craco build",
    "lint": "eslint --fix ./src ./types",
    "dist": "tsc -p .",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "build_zip": "shx rm -rf $npm_config_datapath/artefacts/afmsankey_$npm_package_version.$npm_config_publish_name.zip && cross-conf-env npm-build-zip --name=$npm_config_publish_name --destination  $npm_config_datapath/artefacts"
  },
  "dependencies": {
